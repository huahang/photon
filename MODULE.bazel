"""photon —— 相机 RAW / JPEG / HEIF 照片与 MP4 / MOV 视频的整理工具集。"""

module(
    name = "photon",
    version = "0.1.0",
    compatibility_level = 1,
)

# 第三方依赖优先来自 Bazel Central Registry（https://registry.bazel.build）。
# BCR 没有的模块仍用 bazel_dep 声明，再用 git_override 固定到具体提交。
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "abseil-cpp", version = "20260817.0")

# jpegli 尚未发布到 BCR，也没有版本标签，固定到 main 上的提交。
# https://github.com/google/jpegli/commit/c7d342c25d3587ac0110c915989ad94f414b6c8d
bazel_dep(name = "jpegli")
git_override(
    module_name = "jpegli",
    remote = "https://github.com/google/jpegli.git",
    commit = "c7d342c25d3587ac0110c915989ad94f414b6c8d",
)

# jpegli 把 highway 钉在 1.3.1，并用 local_path_override 指向 third_party/highway。
# 非根模块的 override 会被忽略，而 1.3.1 又不在 BCR 上，所以在根模块复现同一提交。
# 补丁与上游 CI 一致：给 highway 的头文件补上 includes = ["."]。
# https://github.com/google/highway/commit/271a9a0ed9de1232d9117f1572c3fe28f8542ec1
bazel_dep(name = "highway", version = "1.3.1")
git_override(
    module_name = "highway",
    remote = "https://github.com/google/highway.git",
    commit = "271a9a0ed9de1232d9117f1572c3fe28f8542ec1",
    patch_strip = 1,
    patches = ["//third_party/jpegli:highway_includes.patch"],
)

# 仅测试使用的依赖。
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)
